# Copie para ".env" e preencha. Veja docs/CONFIGURACAO.md.
# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Google Cloud → Maps SDK for Android (obrigatória para o mapa no Android)
GOOGLE_MAPS_ANDROID_API_KEY=
# Opcional (apenas se usar Google Maps no iOS; o padrão é Apple Maps)
GOOGLE_MAPS_IOS_API_KEY=

# expo.dev → seu projeto → Project ID (necessário para notificações push)
EAS_PROJECT_ID=
